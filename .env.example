# Duplicate this file as .env and choose your provider/mode explicitly.

# Provider selection: openai (cloud) or ollama (local open-source models).
LLM_PROVIDER=openai

# OpenAI mode (default cloud).
OPENAI_API_KEY=your_openai_api_key_here
# Optional: OpenAI-compatible proxy base URL (must include scheme and host).
# OPENAI_BASE_URL=https://api.openai.com
# Optional: choose your global chat/embedding models (works for both providers).
# LLM_CHAT_MODEL=gpt-4.1
# LLM_EMBED_MODEL=text-embedding-3-small

# Ollama mode (local, open-source).
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=llama3.1
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Offline deterministic mode for local demo/tests (no network calls).
# Set to true to force offline fallback behavior whatever provider is configured.
OPENAI_OFFLINE=false

# Optional web Basic Auth (protects UI and API when set).
# WEB_LOGIN=admin
# WEB_PASSWORD=change_me
